# Copy to .env.local and fill in. Never commit .env.local.

# Session signing key. Generate one with: npx auth secret
AUTH_SECRET=

# LINE Login channel (developers.line.biz). Callback URL: <site>/api/auth/callback/line
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Google OAuth client (console.cloud.google.com). Callback URL: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres connection string. Leave empty locally to use the embedded database in ./.data
DATABASE_URL=

# TokenMe key for the AI judge and translation. Without it, pitches stay unscored.
TOKENME_API_KEY=
# Optional overrides
# TOKENME_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
# TOKENME_BASE_URL=https://api.tokenme.limited/api/v1
# JUDGE_DAILY_LIMIT=5
# TRANSLATE_DAILY_LIMIT=30
# UPLOAD_DAILY_LIMIT=30

# Account ids allowed to moderate, comma-separated. Open /moderate while signed in to see your own id.
MODERATOR_IDS=
