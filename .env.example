# Copy to .env.local and fill in. Never commit .env.local.

# Session signing key. Generate one with: npx auth secret
AUTH_SECRET=

# LINE Login channel (developers.line.biz). Callback URL: <site>/api/auth/callback/line
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# Google OAuth client (console.cloud.google.com). Callback URL: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres connection string. Leave empty locally to use the embedded database in ./.data
DATABASE_URL=

# Anthropic API key for the AI judge and translation (console.anthropic.com). Without it, pitches stay unscored.
ANTHROPIC_API_KEY=
# Optional overrides
# JUDGE_MODEL=claude-opus-5-5
# TRANSLATE_MODEL=claude-haiku-5-5
# JUDGE_DAILY_LIMIT=5
# TRANSLATE_DAILY_LIMIT=30
